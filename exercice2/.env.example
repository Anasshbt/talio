
# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=talio
POSTGRES_PASSWORD=talio
POSTGRES_DB=talio

# ── Backend ───────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@db:5432/<DB>
# Le hostname "db" = nom du service Docker Compose (ne pas changer)
DATABASE_URL=postgresql+asyncpg://talio:talio@db:5432/talio

# ── Ports exposés (optionnel — valeurs par défaut si non renseignées) ─────────
FRONTEND_PORT=8088
BACKEND_PORT=8089
